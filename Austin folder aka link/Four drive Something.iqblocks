" id=\"D#,ms#c.Pdoz[.RF8eGY\"><field name=\"MOTOR\">beam_claw_lifter</field><value name=\"TORQUE\"><shadow type=\"math_number\" id=\"cTBctV75y/rTc=3O)_t*\"><field name=\"NUM\">100</field></shadow></value><next><block type=\"iq_motion_set_motor_stopping\" id=\"T{gN^AYx||!oOt{|j%r2\"><field name=\"MOTOR\">pin_claw_lifter</field><field name=\"MODE\">hold</field><next><block type=\"iq_motion_set_motor_stopping\" id=\"L^^gt~;]NHlO*C]~sDar\"><field name=\"MOTOR\">beam_claw_lifter</field><field name=\"MODE\">hold</field><next><block type=\"iq_motion_pneumatics_compressor\" id=\"Jy^?oTsScZgb!`;?nC;*\"><field name=\"PNEUMATIC\">Pneumatic1</field><field name=\"STATE\">on</field><next><block type=\"iq_motion_pneumatics_compressor\" id=\"hvxXJ2Z=@YhGy.7z$!nG\"><field name=\"PNEUMATIC\">Pneumatic2</field><field name=\"STATE\">on</field><next><block type=\"iq_motion_pneumatics_cylinder\" id=\"=)%Q2yFW6[HMLDPKf7fL\"><field name=\"PNEUMATIC\">Pneumatic2</field><field name=\"CYLINDER\">cylinder1</field><field name=\"STATE\">extend</field><next><block type=\"iq_motion_pneumatics_cylinder\" id=\"PB7Fv%Y5VNayN.YaH/6G\"><field name=\"PNEUMATIC\">Pneumatic1</field><field name=\"CYLINDER\">cylinder2</field><field name=\"STATE\">extend</field><next><block type=\"iq_motion_pneumatics_cylinder\" id=\"Ju#{q5{83|*2-cJa[bxh\"><field name=\"PNEUMATIC\">Pneumatic1</field><field name=\"CYLINDER\">cylinder1</field><field name=\"STATE\">retract</field><next><block type=\"iq_variables_set_boolean_variable\" id=\"%EtNzq}6Qh?bBjd1btg+\"><field name=\"VARIABLE\" id=\"y8Utj~V7SS)3yr-bm)XJ\" variabletype=\"boolean\">beam_claw</field><value name=\"VALUE\"><shadow type=\"bool_input\" id=\"HOxG|q/qt$pk_l2uqu*w\"><field name=\"VALUE\">true</field></shadow></value><next><block type=\"iq_variables_set_boolean_variable\" id=\"z*gZF$d-V8gUdng{4dl5\"><field name=\"VARIABLE\" id=\"Xo)y(e0hAp^G4c;|)~*l\" variabletype=\"boolean\">P_in_air</field><value name=\"VALUE\"><shadow type=\"bool_input\" id=\"!c)(6[DL,[Jy:LJ!N