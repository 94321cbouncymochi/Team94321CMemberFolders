{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nbrain_inertial = Inertial()\nmotor_10 = Motor(Ports.PORT10, False)\n\n\n\n# generating and setting random seed\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    xaxis = brain_inertial.acceleration(XAXIS) * 1000\n    yaxis = brain_inertial.acceleration(YAXIS) * 1000\n    zaxis = brain_inertial.acceleration(ZAXIS) * 1000\n    systemTime = brain.timer.system() * 100\n    urandom.seed(int(xaxis + yaxis + zaxis + systemTime)) \n    \n# Initialize random seed \ninitializeRandomSeed()\n\n#endregion VEXcode Generated Robot Configuration\n\nWallXs = [0 for x in range(5)]\nWallYs = [0 for x in range(5)]\nPlayerY = 0\ni = 0\nGapSize = 0\nSpeed = 0\nScore = 0\n\ndef Draw():\n    global WallXs, WallYs, PlayerY, i, GapSize, Speed, Score\n    # brain.screen.clear_screen()\n    brain.screen.set_pen_color(Color.BLACK)\n    brain.screen.draw_rectangle(0,0,1000,1000)\n    wait(5, MSEC)\n    brain.screen.set_pen_width(1)\n    # brain.screen.set_pen_color(Color.BLACK)\n    # brain.screen.draw_circle(5, PlayerY, 3)\n\n    # update player postition\n    PlayerY = 50 + motor_10.position(DEGREES) * 0.75\n\n    brain.screen.set_pen_color(Color.WHITE)\n    brain.screen.draw_circle(5, PlayerY, 3)\n    \n    brain.screen.set_pen_width(2)\n    i = 0\n    for repeat_count in range(int(len(WallXs))):\n        # brain.screen.set_pen_color(Color.BLACK)\n        # brain.screen.draw_line(WallXs[i - 1], WallYs[i - 1] - GapSize, WallXs[i - 1], 0)\n        # brain.screen.draw_line(WallXs[i - 1], WallYs[i - 1] + GapSize, WallXs[i - 1], 160)\n        WallXs[i - 1] = WallXs[i - 1] - Speed\n\n        if WallXs[i - 1] < 13 and WallXs[i - 1] > 0:\n            brain.screen.set_pen_color(Color.RED)\n            brain.screen.draw_line(WallXs[i - 1], WallYs[i - 1] - GapSize, WallXs[i - 1], 0)\n            brain.screen.draw_line(WallXs[i - 1], WallYs[i - 1] + GapSize, WallXs[i - 1], 160)\n            if abs(WallYs[i-1]-PlayerY) > 10:\n                brain.screen.print(Score)\n                wait(1000, SECONDS)\n        else:\n            Score += 1\n            brain.screen.set_pen_color(Color.WHITE)\n            brain.screen.draw_line(WallXs[i - 1], WallYs[i - 1] - GapSize, WallXs[i - 1], 0)\n            brain.screen.draw_line(WallXs[i - 1], WallYs[i - 1] + GapSize, WallXs[i - 1], 160)\n\n\n        i = i + 1\n    \n\ndef ManagePlayer():\n    global WallXs, WallYs, PlayerY, i, GapSize, Speed\n    # PlayerY = 50 + motor_10.position(DEGREES) * 0.5\n    for WallX in range((len(WallXs))):\n        print(WallX)\n\n\ndef SummonWall_wallHeight(SummonWall_wallHeight__wallHeight):\n    global WallXs, WallYs, PlayerY, i, GapSize, Speed\n    i = 0\n    for repeat_count2 in range(int(len(WallXs))):\n        if WallXs[i - 1] < 0:\n            WallXs[i - 1] = 160\n            WallYs[i - 1] = SummonWall_wallHeight__wallHeight\n            break\n        i = i + 1\n\ndef when_started1():\n    global WallXs, WallYs, PlayerY, i, GapSize, Speed\n    Speed = 3\n    PlayerY = 50\n    GapSize = 15\n    WallYs = [-1, -1, -1, -1, -1]\n    WallXs = [-1, -1, -1, -1, -1]\n    SummonWall_wallHeight(int(round(urandom.uniform(20, 88), 2)))\n    while True:\n        for repeat_count3 in range(int(75 / Speed)):\n            ManagePlayer()\n            Draw()\n            wait(50, MSEC)\n        SummonWall_wallHeight(int(round(urandom.uniform(20, 88), 2)))\n        Speed = Speed + 0.05\n        wait(50, MSEC)\n\nwhen_started1()","textLanguage":"python","robotConfig":[{"port":[10],"name":"motor_10","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22}],"slot":1,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.61.0","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}