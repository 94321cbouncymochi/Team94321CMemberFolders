{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nbrain_inertial = Inertial()\n\n\n\n# generating and setting random seed\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    xaxis = brain_inertial.acceleration(XAXIS) * 1000\n    yaxis = brain_inertial.acceleration(YAXIS) * 1000\n    zaxis = brain_inertial.acceleration(ZAXIS) * 1000\n    systemTime = brain.timer.system() * 100\n    urandom.seed(int(xaxis + yaxis + zaxis + systemTime)) \n    \n# Initialize random seed \ninitializeRandomSeed()\n\n#endregion VEXcode Generated Robot Configuration\n\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n# \tAuthor:       VEX\n# \tCreated:\n# \tDescription:  VEXcode IQ Python Project\n# \n# ------------------------------------------\n\n# Library imports\nfrom vex import *\nimport random\n\n# Begin project code\nmode = 0\ntiles = []\ncurColor = Color.BLACK\n\ndef render():\n    global tiles, curColor\n\n    for i, tile in enumerate(tiles):\n        if tile == 0:\n            brain.screen.draw_rectangle(i*20, 0, 20, 54, curColor)\n            brain.screen.draw_rectangle(i*20, 54, 20, 54, Color.WHITE)\n        else:\n            brain.screen.draw_rectangle(i*20, 0, 20, 54, Color.WHITE)\n            brain.screen.draw_rectangle(i*20, 54, 20, 54, curColor)\n\ndef start_game():\n    global tiles, curColor, mode\n\n    score = 0\n    brain.timer.clear()\n    while True:\n        curInput = None\n        if brain.buttonLeft.pressing():\n            while(brain.buttonLeft.pressing()):\n                pass\n            curInput = 0\n        if brain.buttonRight.pressing():\n            while(brain.buttonRight.pressing()):\n                pass\n            curInput = 1\n        if curInput != None:\n            if curInput == tiles[0]:\n                if mode == 0:\n                    brain.play_note(3+random.randrange(2), random.randrange(7), 100)\n                    pass\n                tiles.pop(0)\n                tiles.append(random.randrange(2))\n                render()\n                score += 1\n            else:\n                if mode == 0:\n                    brain.play_sound(SoundType.ALARM)\n\n                curColor = Color.RED\n                render()\n\n                brain.screen.set_fill_color(Color.RED)\n                brain.screen.draw_rectangle(-10, -10, 1000, 1000)\n                \n                \n                brain.screen.set_cursor(1, 1)\n                brain.screen.set_font(FontType.MONO20)\n                SPS = \"\" + str(round(score / brain.timer.time(SECONDS), 2)) + \" /Second\"\n                brain.screen.print(SPS, opaque=False)\n\n                brain.screen.set_cursor(2, 1)\n                brain.screen.set_font(FontType.MONO40)\n                brain.screen.print(score, opaque=False)\n\n\n                brain.timer.clear()\n                wait(2,SECONDS)\n                score = 0\n                curColor = Color.BLACK\n                brain.screen.clear_screen()\n                render()\n\n\ndef menu_select():\n    global mode\n    brain.screen.print(\"< - Full Game\")\n    brain.screen.next_row()\n    brain.screen.print(\"> - Silent Game\")\n    brain.screen.next_row()\n    while True:\n        if brain.buttonLeft.pressing():\n            while(brain.buttonLeft.pressing()):\n                pass\n            mode = 0\n            break\n        if brain.buttonRight.pressing():\n            while(brain.buttonRight.pressing()):\n                pass\n            mode = 1\n            break\n    brain.screen.clear_screen()\n    \n\ndef security():\n    security_code = [0,0,1,0,2]\n\n    i = 0\n    while True:\n        if i >= 5:\n            break\n\n        if brain.buttonLeft.pressing():\n            while brain.buttonLeft.pressing():\n                pass\n            if security_code[i] == 0:\n                i += 1\n            else:\n                brain.program_stop()\n        \n        if brain.buttonRight.pressing():\n            while brain.buttonRight.pressing():\n                pass\n            if security_code[i] == 1:\n                i += 1\n            else:\n                brain.program_stop()\n\n        if brain.buttonCheck.pressing():\n            while brain.buttonCheck.pressing():\n                pass\n            if security_code[i] == 2:\n                i += 1\n            else:\n                brain.program_stop()\n\n\ndef main():\n    global tiles\n\n    # security()\n    # menu_select()\n\n    \n    \n    for repeat_count in range(8): \n        tiles.append(random.randrange(2))\n    render()\n    start_game()\n\nmain()\n\n","textLanguage":"python","robotConfig":[],"slot":4,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.65.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}