{"mode":"Text","hardwareTarget":"brain","textContent":"# ---------------------------------------------------------\n# VEX IQ CHESS - STABLE FINAL VERSION\n# FIXED: Ghosting, decimal pixel bleed, and double-selection\n# ---------------------------------------------------------\nfrom vex import *\n\nbrain = Brain()\n\n# --- SETTINGS (Strict Integers) ---\nCELL = 12\nOFFSET_X = 42 \nOFFSET_Y = 12\n\n# --- BOARD DATA ---\nboard = [\n    [\"r\",\"n\",\"b\",\"q\",\"k\",\"b\",\"n\",\"r\"],\n    [\"p\",\"p\",\"p\",\"p\",\"p\",\"p\",\"p\",\"p\"],\n    [\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],\n    [\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],\n    [\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],\n    [\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],\n    [\"P\",\"P\",\"P\",\"P\",\"P\",\"P\",\"P\",\"P\"],\n    [\"R\",\"N\",\"B\",\"Q\",\"K\",\"B\",\"N\",\"R\"]\n]\n\nturn = \"White\"\ncursor_x = 0\ncursor_y = 0\nselected = False\nsel_x = -1\nsel_y = -1\npossible_moves = []\n\n# --- HELPERS ---\ndef inside(x, y): \n    return 0 <= x <= 7 and 0 <= y <= 7\n\ndef is_white(p): \n    return p.isupper()\n\ndef is_black(p): \n    return p.islower()\n\ndef is_friendly(p):\n    if p == \".\": \n        return False\n    if turn == \"White\":\n        return is_white(p)\n    else:\n        return is_black(p)\n\ndef enemy(p1, p2):\n    if p2 == \".\": \n        return False\n    return (is_white(p1) and is_black(p2)) or (is_black(p1) and is_white(p2))\n\n# --- MOVE CALCULATOR ---\ndef get_moves(x, y):\n    moves = [] # Start with a perfectly clean slate\n    p = board[y][x]\n    if p == \".\": \n        return moves\n    \n    pt = p.lower()\n\n    if pt == \"p\": # Pawn\n        d = -1 if is_white(p) else 1\n        if inside(x, y+d) and board[y+d][x] == \".\":\n            moves.append((x, y+d))\n            if y == (6 if is_white(p) else 1) and board[y+2*d][x] == \".\":\n                moves.append((x, y+2*d))\n        for dx in [-1, 1]:\n            if inside(x+dx, y+d) and enemy(p, board[y+d][x+dx]):\n                moves.append((x+dx, y+d))\n                \n    elif pt in [\"r\", \"b\", \"q\"]: # Sliders\n        dirs = []\n        if pt in [\"r\", \"q\"]: dirs += [(1,0),(-1,0),(0,1),(0,-1)]\n        if pt in [\"b\", \"q\"]: dirs += [(1,1),(-1,1),(1,-1),(-1,-1)]\n        for dx, dy in dirs:\n            nx, ny = x+dx, y+dy\n            while inside(nx, ny):\n                if board[ny][nx] == \".\": \n                    moves.append((nx, ny))\n                else:\n                    if enemy(p, board[ny][nx]): \n                        moves.append((nx, ny))\n                    break\n                nx += dx\n                ny += dy\n                \n    elif pt == \"n\": # Knight\n        for dx, dy in [(1,2),(2,1),(-1,2),(-2,1),(1,-2),(2,-1),(-1,-2),(-2,-1)]:\n            if inside(x+dx, y+dy):\n                if board[y+dy][x+dx] == \".\" or enemy(p, board[y+dy][x+dx]):\n                    moves.append((x+dx, y+dy))\n                    \n    elif pt == \"k\": # King\n        for dx in [-1,0,1]:\n            for dy in [-1,0,1]:\n                if dx == 0 and dy == 0: \n                    continue\n                if inside(x+dx, y+dy):\n                    if board[y+dy][x+dx] == \".\" or enemy(p, board[y+dy][x+dx]):\n                        moves.append((x+dx, y+dy))\n                        \n    return moves\n\n# --- DRAWING ---\ndef draw():\n    # Force small font and clear the screen completely\n    brain.screen.set_font(FontType.MONO12)\n    brain.screen.set_fill_color(Color.BLACK)\n    brain.screen.clear_screen()\n\n    for y in range(8):\n        for x in range(8):\n            # int() prevents the ghosting on middle ranks\n            sx = int(OFFSET_X + (x * CELL))\n            sy = int(OFFSET_Y + (y * CELL))\n\n            # 1. TILE BACKGROUND\n            if (x + y) % 2 == 0:\n                brain.screen.set_fill_color(Color.WHITE)\n            else:\n                brain.screen.set_fill_color(Color.BLACK)\n            brain.screen.draw_rectangle(sx, sy, CELL, CELL)\n\n            # 2. SELECTION HIGHLIGHT (GREEN)\n            if selected and x == sel_x and y == sel_y:\n                brain.screen.set_fill_color(Color.GREEN)\n                brain.screen.draw_rectangle(sx, sy, CELL, CELL)\n\n            # 3. POSSIBLE MOVES (BLUE DOTS)\n            if (x, y) in possible_moves:\n                brain.screen.set_fill_color(Color.BLUE)\n                brain.screen.draw_rectangle(sx + 4, sy + 4, 4, 4)\n\n            # 4. PIECE TEXT\n            p = board[y][x]\n            if p != \".\":\n                if (x + y) % 2 == 0: \n                    brain.screen.set_pen_color(Color.BLACK)\n                else: \n                    brain.screen.set_pen_color(Color.WHITE)\n                \n                # Keep text black if it's on a green/blue highlight\n                if (selected and x == sel_x and y == sel_y) or ((x,y) in possible_moves):\n                    brain.screen.set_pen_color(Color.BLACK)\n                \n                brain.screen.print_at(p, x=sx + 3, y=sy + 10)\n\n            # 5. CURSOR (RED OUTLINE)\n            if x == cursor_x and y == cursor_y:\n                brain.screen.set_pen_color(Color.RED)\n                brain.screen.set_fill_color(Color.TRANSPARENT)\n                brain.screen.draw_rectangle(sx, sy, CELL, CELL)\n\n    # UI LABELS\n    brain.screen.set_fill_color(Color.BLACK)\n    brain.screen.set_pen_color(Color.WHITE)\n    brain.screen.print_at(\"TURN: \" + turn.upper(), x=10, y=120)\n    \n    # Flush pen color to stop bottom-line bleeding\n    brain.screen.set_pen_color(Color.BLACK) \n\n# --- NAVIGATION & WRAPPING ---\ndef get_idx(): \n    return (cursor_y * 8) + cursor_x\n\ndef set_by_idx(idx):\n    global cursor_x, cursor_y\n    idx %= 64 # Wraps 0 to 63\n    cursor_x = int(idx % 8)\n    cursor_y = int(idx // 8)\n\ndef move_right(): set_by_idx(get_idx() + 1)\ndef move_left():  set_by_idx(get_idx() - 1)\ndef move_up():    global cursor_y; cursor_y = (cursor_y - 1) % 8\ndef move_down():  global cursor_y; cursor_y = (cursor_y + 1) % 8\n\n# --- INTERACTION ---\ndef press_check():\n    global selected, sel_x, sel_y, possible_moves, turn\n    target = board[cursor_y][cursor_x]\n\n    if not selected:\n        # Select a piece\n        if is_friendly(target):\n            selected = True\n            sel_x = cursor_x\n            sel_y = cursor_y\n            possible_moves = get_moves(sel_x, sel_y)\n    else:\n        # If clicked same piece, deselect\n        if cursor_x == sel_x and cursor_y == sel_y:\n            selected = False\n            possible_moves = []\n        # If clicked another friendly piece, switch to it\n        elif is_friendly(target):\n            sel_x = cursor_x\n            sel_y = cursor_y\n            possible_moves = get_moves(sel_x, sel_y)\n        # If clicked a valid move, execute it\n        elif (cursor_x, cursor_y) in possible_moves:\n            board[cursor_y][cursor_x] = board[sel_y][sel_x]\n            board[sel_y][sel_x] = \".\"\n            turn = \"Black\" if turn == \"White\" else \"White\"\n            selected = False\n            possible_moves = []\n        # Otherwise, cancel selection\n        else:\n            selected = False\n            possible_moves = []\n\n# --- MAIN LOOP ---\ndraw()\n\nwhile True:\n    clicked = False\n    \n    if brain.buttonRight.pressing(): \n        move_right()\n        clicked = True\n    elif brain.buttonLeft.pressing(): \n        move_left()\n        clicked = True\n    elif brain.buttonUp.pressing(): \n        move_up()\n        clicked = True\n    elif brain.buttonDown.pressing(): \n        move_down()\n        clicked = True\n    elif brain.buttonCheck.pressing(): \n        press_check()\n        clicked = True\n        wait(200, MSEC) # CRITICAL: This stops the double-selection bug\n\n    if clicked:\n        draw()\n        wait(150, MSEC) # Controls how fast the cursor moves when holding a button\n        \n    wait(20, MSEC)","textLanguage":"python","robotConfig":[],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.65.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}