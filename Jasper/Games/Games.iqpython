{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nbrain_inertial = Inertial\n\nGame = 1\nwhile not brain.buttonCheck.pressing:\nif brain.buttonLeft.pressing():\n    Game = Game + 1\nelif brain.buttonRight.pressing():\n    Game = Game - 1\nelif brain.buttonCheck.pressing():\n    if Game == 1:\n\n    # generating and setting random seed\n    def initializeRandomSeed():\n        wait(100, MSEC)\n        xaxis = brain_inertial.acceleration(XAXIS) * 1000\n        yaxis = brain_inertial.acceleration(YAXIS) * 1000\n        zaxis = brain_inertial.acceleration(ZAXIS) * 1000\n        systemTime = brain.timer.system() * 100\n        urandom.seed(int(xaxis + yaxis + zaxis + systemTime)) \n    \n    # Initialize random seed \n    initializeRandomSeed()\n\n    from vex import *\n\n    # ----------------- Constants -----------------\n    CELL_SIZE   = 10\n    ROWS        = 8          # visible rows (must match LEVEL height)\n    COLS        = 16         # visible columns on screen\n    GRAVITY     = 1\n    JUMP_VEL    = -3\n\n    # ----------------- One scrolling level -----------------\n    # Use only ' ' (space) for empty and '#' for solid blocks\n    # All rows MUST be the same length.\n    LEVEL = [\n        \"                        ##       ###           ##        ###           ##      ###    ###        ##        ###      ###     ##        ###         ## \",\n        \"             ###        ###                 ###         ######                                     ##                 ####        ###              ##\",\n        \"           ##                     ###      ####                        ####       ###               ###        ###      ###       ####            ###\",\n        \"        ###           ###        ####                 ####         ###  ###        ###           ######        ###      ####        ###             #\",\n        \"      ###        ###  ####   #    ###      ####     ####        ####    ###          ##              ###      ####      ###                       ## \",\n        \"    ###      ######    ###    # ####      ####     ###        ####      ####          #       ###    ###         #                ####               \",\n        \"  ####   ##########  ####   ########   ########   ####   #########   ########   ########   #######        ########  ########   ########           ## \",\n        \"#####################################################################################################################################################\",\n    ]\n    # Quick check: ensure LEVEL shape is valid\n    LEVEL_HEIGHT = len(LEVEL)\n    LEVEL_WIDTH  = len(LEVEL[0])\n\n    # ----------------- Player & camera -----------------\n    player_x = 0          # screen-space X (0..COLS-1)\n    player_y = ROWS - 2   # grid Y (0..ROWS-1; 0 is top)\n    vel_y    = 0\n    on_ground = False\n\n    offset = 0            # leftmost visible world column\n\n    # ----------------- Tile helpers -----------------\n    def get_tile_world(wx, y):\n        if 0 <= y < ROWS and 0 <= wx < LEVEL_WIDTH:\n            return LEVEL[y][wx]\n        return '#'  # treat outside as solid\n\n    def is_solid_world(wx, y):\n        return get_tile_world(wx, y) == '#'\n\n    def is_solid_screen(sx, y):\n        return is_solid_world(offset + sx, y)\n\n    # ----------------- Drawing -----------------\n    def draw_world_and_player():\n        brain.screen.clear_screen()\n\n        # draw visible window\n        for y in range(ROWS):\n            for sx in range(COLS):\n                wx = offset + sx\n                if 0 <= wx < LEVEL_WIDTH and LEVEL[y][wx] == '#':\n                    brain.screen.set_fill_color(Color.BLUE)\n                    brain.screen.draw_rectangle(sx * CELL_SIZE, y * CELL_SIZE, CELL_SIZE, CELL_SIZE)\n\n        # draw player\n        brain.screen.set_fill_color(Color.GREEN)\n        py = min(max(player_y, 0), ROWS - 1)\n        brain.screen.draw_rectangle(player_x * CELL_SIZE, py * CELL_SIZE, CELL_SIZE, CELL_SIZE)\n\n        # HUD\n        brain.screen.set_cursor(1, 1)\n        brain.screen.print(\"X:\")\n        brain.screen.print(offset + player_x)\n        brain.screen.print(\"/\")\n        brain.screen.print(LEVEL_WIDTH - 1)\n        brain.screen.render()\n\n    # ----------------- Camera scroll -----------------\n    def maybe_scroll():\n        global offset, player_x\n        # Scroll right if player nears right edge AND we can still scroll further\n        if player_x > 11 and offset + COLS < LEVEL_WIDTH:\n            offset += 1\n            player_x -= 1\n        # Clamp offset so we never scroll past the last possible screen\n        if offset > LEVEL_WIDTH - COLS:\n            offset = LEVEL_WIDTH - COLS\n        # Scroll left if player nears left edge and there is room left\n        if player_x < 2 and offset > 0:\n            offset -= 1\n            player_x += 1\n        if offset < 0:\n            offset = 0\n\n    # ----------------- Physics & input -----------------\n    def update_player():\n        global player_x, player_y, vel_y, on_ground\n\n        # horizontal input\n        dx = 0\n        if brain.buttonLeft.pressing():\n            dx = -1\n        elif brain.buttonRight.pressing():\n            dx = 1\n\n        # horizontal move with collision\n        nx_screen = player_x + dx\n        if 0 <= nx_screen < COLS:\n            if not is_solid_screen(nx_screen, player_y):\n                player_x = nx_screen\n            else:\n                # try small stair step\n                if player_y > 0 and not is_solid_screen(nx_screen, player_y - 1) and not is_solid_screen(player_x, player_y - 1):\n                    player_y -= 1\n                    if not is_solid_screen(nx_screen, player_y):\n                        player_x = nx_screen\n\n        # jump\n        if brain.buttonCheck.pressing() and on_ground:\n            vel_y = JUMP_VEL\n            on_ground = False\n\n        # gravity\n        vel_y += GRAVITY\n        new_y = player_y + vel_y\n\n        # falling\n        if vel_y > 0:\n            hit = False\n            for y in range(int(player_y) + 1, int(new_y) + 1):\n                if y >= ROWS:\n                    new_y = ROWS - 1\n                    vel_y = 0\n                    on_ground = True\n                    hit = True\n                    break\n                if is_solid_screen(player_x, y):\n                    new_y = y - 1\n                    vel_y = 0\n                    on_ground = True\n                    hit = True\n                    break\n            if not hit:\n                on_ground = False\n\n        # rising\n        if vel_y < 0:\n            for y in range(player_y - 1, int(new_y) - 1, -1):\n                if is_solid_screen(player_x, y):\n                    new_y = y + 1\n                    vel_y = 0\n                    break\n\n        player_y = int(new_y)\n\n        if player_y >= ROWS:\n            player_y = ROWS - 2\n            vel_y = 0\n            on_ground = False\n\n        maybe_scroll()\n\n    # ----------------- Win check -----------------\n    def reached_end():\n        world_x = offset + player_x\n        return world_x >= LEVEL_WIDTH - 1\n\n    def win_screen():\n        brain.screen.clear_screen()\n        brain.screen.set_cursor(3, 5)\n        brain.screen.print(\"YOU WIN!\")\n        brain.screen.render()\n        while True:\n            wait(20, MSEC)\n\n    # Choose the starting world position for the player\n    START_WORLD_X = 0  # <-- pick the world tile index you want to start at\n\n    # Camera offset so that the player appears in the same relative position on screen\n    offset = START_WORLD_X - 2  # '2' means player starts 2 tiles from the left edge\n    if offset < 0:\n        offset = 0\n    if offset > LEVEL_WIDTH - COLS:\n        offset = LEVEL_WIDTH - COLS\n\n    # Player's screen X is just their world X minus the offset\n    player_x = START_WORLD_X - offset\n    player_y = ROWS - 2  # or wherever you want vertically\n\n    # ----------------- Main loop -----------------\n    while True:\n        update_player()\n        draw_world_and_player()\n        if reached_end():\n            win_screen()\n        wait(16, MSEC)\n","textLanguage":"python","robotConfig":[],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":""}}