{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nbrain_inertial = Inertial()\n\n\n\n# generating and setting random seed\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    xaxis = brain_inertial.acceleration(XAXIS) * 1000\n    yaxis = brain_inertial.acceleration(YAXIS) * 1000\n    zaxis = brain_inertial.acceleration(ZAXIS) * 1000\n    systemTime = brain.timer.system() * 100\n    urandom.seed(int(xaxis + yaxis + zaxis + systemTime)) \n    \n# Initialize random seed \ninitializeRandomSeed()\n\n#endregion VEXcode Generated Robot Configuration\n#region VEXcode Generated Robot Configuration\nfrom vex import *\n\n# Brain should be defined by default\nbrain = Brain()\n#endregion\n\nimport urandom\n\n# ---------- Game settings ----------\nSCREEN_W = 212\nGROUND_Y  = 90          # ground line (bigger = lower on screen)\nPLAYER_X  = 25\nPLAYER_H  = 12\nOB_W      = 10\n\n# Cactus heights\nCACTUS_SHORT = 10\nCACTUS_TALL  = 18\n\n# Screen Y increases downward, so:\nGRAVITY       = 1       # pulls down\nJUMP_STRENGTH = -8      # negative = up\n\nBASE_SPEED    = 3.0\nSPEED_ACCEL   = 0.1    # slower acceleration\nMAX_SPEED     = 9.0\n\n# ---------- State ----------\nplayer_y = GROUND_Y\nplayer_vy = 0\n\nob_x = SCREEN_W\nob_speed = BASE_SPEED\nob_h = CACTUS_SHORT\n\nscore = 0\ngame_over = False\n\n# ---------- Draw helpers ----------\ndef draw_ground():\n    brain.screen.draw_line(0, GROUND_Y, SCREEN_W, GROUND_Y)\n\ndef draw_player():\n    brain.screen.draw_rectangle(PLAYER_X, player_y - PLAYER_H, PLAYER_H, PLAYER_H)\n\ndef draw_obstacle():\n    brain.screen.draw_rectangle(ob_x, GROUND_Y - ob_h, OB_W, ob_h)\n\ndef draw_ui():\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"Score: \")\n    brain.screen.print(score)\n\n# ---------- Mechanics ----------\ndef reset_obstacle():\n    global ob_x, score, ob_speed, ob_h\n    ob_x = SCREEN_W\n    score += 1\n    # pick random height\n    if urandom.randint(0, 1) == 0:\n        ob_h = CACTUS_SHORT\n    else:\n        ob_h = CACTUS_TALL\n    # speed up a little\n    ob_speed = min(ob_speed + SPEED_ACCEL, MAX_SPEED)\n\ndef jump():\n    global player_vy\n    if player_y == GROUND_Y:         # only jump from ground\n        player_vy = JUMP_STRENGTH\n\ndef restart():\n    global player_y, player_vy, ob_x, ob_speed, score, game_over, ob_h\n    player_y = GROUND_Y\n    player_vy = 0\n    ob_x = SCREEN_W\n    ob_speed = BASE_SPEED\n    score = 0\n    game_over = False\n    ob_h = CACTUS_SHORT\n\n# ---------- Loop ----------\nwhile True:\n    brain.screen.clear_screen()\n\n    if not game_over:\n        # input (only Check)\n        if brain.buttonCheck.pressing():\n            jump()\n\n        # physics\n        player_y += player_vy\n        player_vy += GRAVITY\n        if player_y >= GROUND_Y:\n            player_y = GROUND_Y\n            player_vy = 0\n\n        # obstacle motion\n        ob_x -= ob_speed\n        if ob_x < -OB_W:\n            reset_obstacle()\n\n        # collision: rectangles overlap?\n        x_overlap = (PLAYER_X + PLAYER_H > ob_x) and (PLAYER_X < ob_x + OB_W)\n        y_overlap = (player_y > GROUND_Y - ob_h)  # player's feet below cactus top\n        if x_overlap and y_overlap:\n            game_over = True\n\n        # draw\n        draw_ground()\n        draw_player()\n        draw_obstacle()\n        draw_ui()\n    else:\n        brain.screen.set_cursor(3, 6)\n        brain.screen.print(\"GAME OVER\")\n        brain.screen.set_cursor(1, 1)\n        brain.screen.print(\"Press Check to \")\n        brain.screen.set_cursor(2, 1)\n        brain.screen.print(\"restart\")\n        if brain.buttonCheck.pressing():\n            restart()\n\n    brain.screen.render()\n    wait(25, MSEC)\n","textLanguage":"python","robotConfig":[],"slot":2,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.65.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":""}}