{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nbrain_inertial = Inertial()\ncontroller = Controller()\n\n\n\n# generating and setting random seed\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    xaxis = brain_inertial.acceleration(XAXIS) * 1000\n    yaxis = brain_inertial.acceleration(YAXIS) * 1000\n    zaxis = brain_inertial.acceleration(ZAXIS) * 1000\n    systemTime = brain.timer.system() * 100\n    urandom.seed(int(xaxis + yaxis + zaxis + systemTime)) \n    \n# Initialize random seed \ninitializeRandomSeed()\n\n#endregion VEXcode Generated Robot Configuration\n\n# Constants\ncoin_count = 0\nCELL_SIZE = 10\nROWS = 8\nCOLS = 16\nGRAVITY = 1\nJUMP_STRENGTH = -3\n\n# Game variables\nplayer_x = 0\nplayer_y = 0\nvel_y = 0\non_ground = False\nlevel_num = 0\n\n# Levels\nlevels = [\n    [\n        \"................\",\n        \"................\",\n        \"................\",\n        \"................\",\n        \"................\",\n        \"................\",\n        \"######.....#####\",\n        \"P...............\"\n    ],\n    [\n        \"................\",\n        \"................\",\n        \"......###.......\",\n        \"P.....#.........\",\n        \"....####........\",\n        \"................\",\n        \"#####.....####..\",\n        \"................\"\n    ],\n    [\n        \"................\",\n        \"................\",\n        \"......##.......#\",\n        \"P.......########\",\n        \"....####.......#\",\n        \"...............#\",\n        \"######.....#####\",\n        \"................\"\n    ],\n    [\n        \"................\",\n        \"................\",\n        \"P...............\",\n        \"...............#\",\n        \"...########....#\",\n        \"..#########....#\",\n        \".##########....#\",\n        \"................\"\n    ],\n    [\n        \"................\",\n        \".P..............\",\n        \"................\",\n        \"..........#..#.#\",\n        \".....#.#.......#\",\n        \"...............#\",\n        \"...#...........#\",\n        \"...............#\"\n    ],\n    [\n        \"................\",\n        \".P..............\",\n        \"................\",\n        \"...........#.#.#\",\n        \"...............#\",\n        \"........#......#\",\n        \"...............#\",\n        \"...............#\"\n    ],\n    [\n        \"...............#\",\n        \"...............#\",\n        \"....######.....#\",\n        \"P.......#.......\",\n        \"....#####......#\",\n        \"...............#\",\n        \"#####........###\",\n        \"###############.\"\n    ],\n    [\n        \"...............#\",\n        \"..............##\",\n        \"P...####......##\",\n        \"...............#\",\n        \"....####..####..\",\n        \"......#........#\",\n        \"......###....###\",\n        \"###############.\"\n    ],\n    [\n        \"...............#\",\n        \"...............#\",\n        \"....######.....#\",\n        \"P....#..........\",\n        \"####..###...####\",\n        \"....###....####.\",\n        \"###..###....###.\",\n        \"###############.\"\n    ],\n    [\n        \"...............#\",\n        \"P...........###.\",\n        \"....######.....#\",\n        \"....#........###\",\n        \"#......####...##\",\n        \"###.....######..\",\n        \"###............#\",\n        \"###############.\"\n    ],\n    [\n        \"...............#\",\n        \"P...........###.\",\n        \"....######.....#\",\n        \"....#........###\",\n        \"#......####...##\",\n        \"........######..\",\n        \"...............#\",\n        \"###############.\"\n    ]\n]\n\n# Load a level\ndef load_level(n):\n    global player_x, player_y, vel_y, on_ground\n    if n >= len(levels):\n        return False\n\n    level = levels[n]\n    level[ROWS - 1] = \"#\" * COLS  # auto-floor\n\n    for y in range(ROWS):\n        for x in range(COLS):\n            if level[y][x] == 'P':\n                player_x = x\n                player_y = y\n\n    vel_y = 0\n    on_ground = False\n    return True\n\ndef get_tile(x, y):\n    if 0 <= y < ROWS and 0 <= x < COLS:\n        return levels[level_num][y][x]\n    return \"#\"\n\ndef is_solid(x, y):\n    return get_tile(x, y) == '#'\n\ndef draw_level():\n    brain.screen.clear_screen()\n    for y in range(ROWS):\n        for x in range(COLS):\n            if levels[level_num][y][x] == '#':\n                brain.screen.set_fill_color(Color.BLUE)\n                brain.screen.draw_rectangle(x * CELL_SIZE, y * CELL_SIZE, CELL_SIZE, CELL_SIZE)\n\n    # player\n    brain.screen.set_fill_color(Color.GREEN)\n    py = max(0, min(player_y, ROWS - 1))\n    brain.screen.draw_rectangle(player_x * CELL_SIZE, py * CELL_SIZE, CELL_SIZE, CELL_SIZE)\n    brain.screen.render()\n\ndef update_player():\n    global player_x, player_y, vel_y, on_ground, level_num\n\n    # left/right movement\n    dx = 0\n    if brain.buttonLeft.pressing():\n        dx = -1\n    elif brain.buttonRight.pressing():\n        dx = 1\n\n    # ground check\n    on_ground = is_solid(player_x, player_y + 1)\n\n    # try horizontal move (NO STEP-UP)\n    if not is_solid(player_x + dx, player_y):\n        player_x += dx\n\n    # jump\n    if brain.buttonCheck.pressing() and on_ground:\n        vel_y = JUMP_STRENGTH\n        on_ground = False\n\n    # gravity\n    vel_y += GRAVITY\n    new_y = player_y + vel_y\n\n    # falling\n    if vel_y > 0:\n        for y in range(player_y + 1, int(new_y) + 1):\n            if y >= ROWS or is_solid(player_x, y):\n                new_y = y - 1\n                vel_y = 0\n                on_ground = True\n                break\n\n    # jumping\n    if vel_y < 0:\n        for y in range(player_y - 1, int(new_y) - 1, -1):\n            if is_solid(player_x, y):\n                new_y = y + 1\n                vel_y = 0\n                break\n\n    player_y = int(new_y)\n\n    # level complete\n    if player_x >= COLS - 1:\n        level_num += 1\n        if not load_level(level_num):\n            brain.screen.clear_screen()\n            brain.screen.set_cursor(3, 4)\n            brain.screen.print(\"YOU WIN!\")\n            brain.screen.render()\n            while True:\n                wait(1)\n\n# Start game\nload_level(0)\n\nwhile True:\n    update_player()\n    draw_level()","textLanguage":"python","robotConfig":[{"port":[],"name":"controller","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","e":"","eDir":"false","f":"","fDir":"false","l3r3":"","l3r3Dir":"false","drive":"none"},"triportSourcePort":22}],"slot":7,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.62.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":""}}