{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nbrain_inertial = Inertial()\nmotor_Left = Motor(Ports.PORT4, True)\nmotor_Right = Motor(Ports.PORT3, True)\nbumper_1 = Bumper(Ports.PORT1)\n\n\n\n# generating and setting random seed\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    xaxis = brain_inertial.acceleration(XAXIS) * 1000\n    yaxis = brain_inertial.acceleration(YAXIS) * 1000\n    zaxis = brain_inertial.acceleration(ZAXIS) * 1000\n    systemTime = brain.timer.system() * 100\n    urandom.seed(int(xaxis + yaxis + zaxis + systemTime)) \n    \n# Initialize random seed \ninitializeRandomSeed()\n\n#endregion VEXcode Generated Robot Configuration\nx = 0\nTemp1 = 0\nbrain = Brain()\ndef Menu():\n    pass\n\ndef when_started():\n    global x\n    Menu()\n    brain.screen.clear_screen()\n    motor_Left.set_max_torque(1, PERCENT)\n    motor_Right.set_max_torque(1, PERCENT)\n    motor_Left.set_stopping(COAST)\n    motor_Right.set_stopping(COAST)\n    #print the position of the motor\n    #while True:\n        ##brain.screen.print(motor_Left.position(DEGREES))\n        ##brain.screen.next_row()\n        ##brain.screen.print(motor_Right.position(DEGREES))\n        ##wait(0.1, SECONDS)\n        ##brain.screen.clear_screen()\n        ##brain.screen.set_cursor(1, 1)\n         \npos = motor_Left.position(DEGREES)\nwhile True:\n    \n    if bumper_1.pressing():\n        wait(0.3, SECONDS)\n        brain.screen.set_cursor(1, 1)\n        brain.screen.clear_screen()\n        brain.screen.print(x)\n        pos = motor_Left.position(DEGREES)\n        if x == 26:\n            x = 1\n        else:\n            x = x+1\n        if pos >= pos+10 :\n            while True:\n                brain.screen.clear_screen()\n\n    \n\n\nwhen_started()\n","textLanguage":"python","robotConfig":[{"port":[4],"name":"motor_Left","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[3],"name":"motor_Right","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[1],"name":"bumper_1","customName":false,"deviceType":"Bumper","deviceClass":"bumper","setting":{},"triportSourcePort":22}],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.0.7","minVersion":"3.0.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"target":"Physical"}