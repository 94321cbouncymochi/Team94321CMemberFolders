{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nbrain_inertial = Inertial()\nleft_drive_smart = Motor(Ports.PORT6, 1.0, False)\nright_drive_smart = Motor(Ports.PORT12, 1.0, True)\ndrivetrain = DriveTrain(left_drive_smart, right_drive_smart, 200, 173, 76, MM, 1)\n\n\n\n# generating and setting random seed\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    xaxis = brain_inertial.acceleration(XAXIS) * 1000\n    yaxis = brain_inertial.acceleration(YAXIS) * 1000\n    zaxis = brain_inertial.acceleration(ZAXIS) * 1000\n    systemTime = brain.timer.system() * 100\n    urandom.seed(int(xaxis + yaxis + zaxis + systemTime)) \n    \n# Initialize random seed \ninitializeRandomSeed()\n\n#endregion VEXcode Generated Robot Configuration\n\n# ------------------------------------------\n# \n# \tProject:      PID_1.0\n# \tAuthor:       Alex\n# \tCreated:      5/3/2026\n# \tDescription:  PID stuff idk what it is\n# \n# ------------------------------------------\n\n# Library imports\nfrom vex import *\n# Begin project code\ndef PID_Drive(target_degrees):\n\n    avg_degrees = 0\n    spd = 75\n    target_degrees = 10000\n    kp = 3\n    kd = 1\n    error = 0\n    lasterror = 0\n    brain_inertial.set_rotation(0, DEGREES)\n    right_drive_smart.spin(FORWARD)\n    left_drive_smart.spin(FORWARD)\n    def whenstarted():\n        global avg_degrees, target_degrees, spd, kp, error , lasterror\n        while(avg_degrees < target_degrees):\n                avg_degrees = (left_drive_smart.position(DEGREES) + right_drive_smart.position(DEGREES)) / 2\n\n                error = brain_inertial.rotation()\n                derivative = error - lasterror\n                lasterror = error\n                power_diff = error * kp + derivative * kd\n\n\n\n                left_drive_smart.set_velocity(spd - power_diff,PERCENT)\n                right_drive_smart.set_velocity(spd + power_diff,PERCENT)\n                print(\"avg_degrees:\" + str(avg_degrees) + \"\\n\" + \"spd:\" + str(spd) + \"\\n\" + \"power_diff:\" + str(power_diff) + \"\\n\")\n                wait(25,MSEC)\n                drivetrain.stop()\n\n                PID_Drive(5000)\n","textLanguage":"python","robotConfig":[{"port":[6,12,null],"name":"drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"2-motor","wheelSize":"200mm","gearRatio":"1:1","direction":"fwd","gyroType":"none","width":"173","unit":"mm","wheelbase":"76","wheelbaseUnit":"mm","xOffset":"0","yOffset":"0","thetaOffset":"0"}}],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.65.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}